{
  "name": "nexus-desktop",
  "version": "1.0.0-rc.1",
  "private": true,
  "description": "A more personal desktop, one setup at a time.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:desktop": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env NEXUS_DEV_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "test": "vitest run",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "dist:linux": "npm run build && electron-builder --linux deb --publish never"
  },
  "build": {
    "appId": "com.nexus.desktop",
    "productName": "NEXUS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "assets/installer.nsh"
    },
    "linux": {
      "target": [
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Utility",
      "maintainer": "NEXUS Contributors",
      "executableName": "nexus"
    }
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^45.3.3",
    "electron-builder": "^26.0.12",
    "jsdom": "^26.0.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wait-on": "^8.0.2"
  },
  "productName": "NEXUS",
  "overrides": {
    "minimatch@^10.2.5": "11.0.9",
    "minimatch@^9.0.3": "11.0.9"
  },
  "homepage": "https://github.com/mafk21/NEXUS"
}
